# PokerForge — Variables d'environnement
# Copier ce fichier en .env.local pour le dev local.
# Dans Vercel, créer ces variables dans Project → Settings → Environment Variables.

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL="https://[project-ref].supabase.co"

# Supabase → Settings → API → anon / public key
# Cette clé est publique côté frontend ; les secrets restent côté Supabase Edge Functions.
VITE_SUPABASE_ANON_KEY="eyJ..."

# Environnement applicatif affichable côté frontend
VITE_APP_ENV="preview"

# Prisma / scripts serveur locaux uniquement, ne pas exposer au frontend.
# Supabase → Settings → Database → Connection string → URI (Transaction Pooler)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase → Settings → Database → Connection string → URI (Session Pooler ou Direct)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS IA — CÔTÉ SERVEUR UNIQUEMENT (Supabase Edge Functions).
#
# ⚠ Ne JAMAIS préfixer une clé IA par VITE_ : tout ce qui est préfixé VITE_ est
#   compilé dans le bundle et donc public. Aucune clé ne doit exister côté
#   navigateur (ni variable, ni localStorage, ni champ de saisie).
#
# Ces secrets se déclarent avec :
#   supabase secrets set OPENAI_API_KEY="sk-..."
# ou dans Supabase → Project Settings → Edge Functions → Secrets.
#
# OPENAI_API_KEY est DÉJÀ utilisé par les fonctions `coach-chat` et
# `meditation-tts` : la fonction `analyze-hand` réutilise le MÊME secret.
# Ne pas créer de nouveau projet OpenAI ni de nouvelle clé si elle existe.
# OPENAI_API_KEY="sk-..."

# Réglages facultatifs de l'endpoint d'analyse du Replayer (edge function
# `analyze-hand`). Tous ont une valeur par défaut : à ne définir que pour ajuster.
# PF_AI_MODEL="gpt-4.1-mini"      # modèle utilisé pour l'explication
# PF_AI_RATE_STANDARD="6"          # analyses / fenêtre — utilisateur standard
# PF_AI_RATE_PREMIUM="20"          # analyses / fenêtre — utilisateur premium
# PF_AI_RATE_WINDOW_S="60"         # durée de la fenêtre glissante (secondes)
# PF_AI_TIMEOUT_MS="40000"         # délai maximal d'appel fournisseur
